# Dev harness: an SS5 project that installs the module by path. Track only its source.
/.dev/*
!/.dev/composer.json
!/.dev/phpunit.xml.dist
!/.dev/_manifest_exclude
!/.dev/app/
/.dev/app/.htaccess
/.dev/app/_config/mimevalidator.yml

# Claude Code local state: session data, worktrees, plans, local settings. Never tracked.
/.claude/throughline/
/.claude/worktrees/
/.claude/plans/
/.claude/settings.local.json
