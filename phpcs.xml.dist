<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Dynamic Edge Cache">
    <description>CodeSniffer ruleset for silverstripe-edge-cache.</description>

    <file>src</file>
    <file>tests</file>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="130"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
