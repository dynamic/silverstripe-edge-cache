{
    "name": "dynamic/silverstripe-edge-cache",
    "description": "Serve Silverstripe HTML from a CDN edge cache: correct cache headers, cache tags and purge on publish. Cloudflare first, adapter interface for other CDNs",
    "license": "BSD-3-Clause",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "CMS",
        "cache",
        "cdn",
        "cloudflare",
        "purge"
    ],
    "authors": [
        {
            "name": "Dynamic",
            "email": "dev@dynamicagency.com",
            "homepage": "https://www.dynamicagency.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5.3",
        "silverstripe/cms": "^5.3",
        "silverstripe/siteconfig": "^5",
        "silverstripe/versioned": "^2",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3",
        "dnadesign/silverstripe-elemental": "^5.3",
        "squizlabs/php_codesniffer": "^3",
        "phpstan/phpstan": "^1.10||^2",
        "cambis/silverstan": "^2.2",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
        "dnadesign/silverstripe-elemental": "Purges the owner page when an element is published"
    },
    "autoload": {
        "psr-4": {
            "Dynamic\\EdgeCache\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Dynamic\\EdgeCache\\Tests\\": "tests/php/"
        }
    }
}
